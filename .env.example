# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=

# Чат, куда поллер постит новые ролики (и где удобно общаться с ботом).
# Для группы это ОТРИЦАТЕЛЬНЫЙ id.
# Пусто -> слежение за профилями выключено.
TARGET_CHAT_ID=

# Необязательный белый список chat id, которым можно пользоваться ботом.
# Пусто -> можно всем.
ALLOWED_CHAT_IDS=

# --- Слежение за профилями ---
# TikTok: username, @handle или ссылка на профиль. Через запятую.
TIKTOK_PROFILES=

# Любые площадки одной строкой — полными ссылками. Через запятую.
# TikTok-профили, YouTube-каналы (/@handle, /channel/..., /c/...), Instagram-профили.
# Instagram для профилей почти всегда требует COOKIES_FILE.
# Пример: https://www.youtube.com/@channel, https://www.instagram.com/user
WATCH_PROFILES=

# Интервал проверки профилей, секунды (не ставьте слишком мало — рейт-лимиты)
POLL_INTERVAL_SECONDS=300

# --- Загрузка ---
# Порядок провайдеров для TikTok: tikwm (без вотермарки, HD), ytdlp (фолбэк).
# Instagram и YouTube всегда идут через yt-dlp.
PROVIDER_ORDER=tikwm,ytdlp

# Эндпоинт tikwm
TIKWM_API_BASE=https://www.tikwm.com

TIKWM_MIN_INTERVAL=1.1

# Лимит Bot API на загрузку файла
MAX_FILE_SIZE_MB=49

# Потолок разрешения для YouTube (чтобы файл влезал в лимит и не требовался ffmpeg).
YOUTUBE_MAX_HEIGHT=720

# Добавлять подпись к медиа: для скачанного — "@автор + ссылка",
# для сгенерированного — сам промпт.
SEND_CAPTION=false

# --- Сеть ---
# Общий прокси. http(s) и socks5 работают из коробки. Пусто -> напрямую.
# Примеры: http://user:pass@host:port   socks5://user:pass@host:1080
PROXY_URL=

# Кто ходит через прокси — раздельно для каждого канала. Значения:
#   on  — использовать PROXY_URL
#   off — напрямую
#   свой URL (socks5://...) — отдельный прокси только для этого канала
PROXY_TELEGRAM=on
PROXY_DOWNLOADS=on
PROXY_AI=off

# --- Авторизация (необязательно; в основном для Instagram / возрастных видео) ---
# Путь к файлу cookies.txt (формат Netscape), выгруженному из залогиненного браузера.
COOKIES_FILE=

# Либо брать cookies прямо из установленного браузера: chrome, firefox, edge, ...
COOKIES_FROM_BROWSER=

# --- AI: чат + картинки ---
# Любой OpenAI-совместимый эндпоинт. Голый хост сам дополнится до /v1,
# полный путь берётся как есть.
# Примеры: https://api.openai.com/v1   https://openrouter.ai/api/v1   https://ваш-шлюз/v1
AI_API_BASE=
AI_API_KEY=

# Модели. Пустая строка = функция выключена, остальные продолжают работать.
AI_CHAT_MODEL=
AI_IMAGE_MODEL=
# Модель для правки фото. Пусто -> берётся AI_IMAGE_MODEL.
AI_IMAGE_EDIT_MODEL=

# Как шлюз отдаёт картинки:
#   images — POST /images/generations и /images/edits (OpenAI, gpt-image-1, dall-e)
#   chat   — POST /chat/completions с картинкой в сообщении (Gemini/nano-banana
#            через OpenRouter и подобные шлюзы)
AI_IMAGE_API=images
# Отдельный режим для правки, если генерация и правка живут на разных API.
# Пусто -> берётся AI_IMAGE_API.
AI_IMAGE_EDIT_API=

# Системный промпт для обычной модели (характер, язык, длина ответов).
AI_SYSTEM_PROMPT=

# Когда модель отвечает на простой текст (без команды):
#   off     — только по /ask
#   mention — в личке на всё, в группе на @упоминание или ответ боту
#   always  — на любое сообщение без ссылки
AI_CHAT_MODE=mention

# Слова-триггеры: первое слово сообщения заменяет команду, писать /ask и /img не нужно.
# Через запятую, регистр не важен, можно и фразу из нескольких слов.
# Работают везде, где работают команды: в группе — без упоминания бота,
# и даже при AI_CHAT_MODE=off. Пусто -> триггеры этой группы выключены.
#   «Ответь что такое Python»   -> обычная модель
#   «Сгенерируй рыжего кота»    -> генерация картинки
#   «Сгенерируй ему шляпу» + приложенное фото -> правка этого фото
AI_CHAT_TRIGGERS=Ответь,Объясни,Расскажи
AI_IMAGE_TRIGGERS=Сгенерируй,Нарисуй
AI_EDIT_TRIGGERS=Отредактируй,Измени,Переделай

# Сколько пар «вопрос-ответ» помнить и как долго.
AI_HISTORY_TURNS=32
AI_HISTORY_TTL_MINUTES=60

# Потолок длины ответа в токенах, 0 -> на усмотрение модели.
AI_MAX_TOKENS=0
# Температура, пусто -> дефолт модели.
AI_TEMPERATURE=

# Размер картинки. Пусто -> дефолт шлюза (и сохраняются пропорции исходника при правке).
# Примеры для gpt-image-1: 1024x1024, 1024x1536, 1536x1024, auto
AI_IMAGE_SIZE=
# Сколько картинок просить за раз.
AI_IMAGE_COUNT=1
# Таймаут запроса к модели, секунды (картинки рисуются долго).
AI_TIMEOUT=180
# Сколько раз повторить при 429 и 5xx (сеть и перегрузка шлюза). 0 -> не повторять.
# Ошибки ключа, модели и баланса не повторяются никогда — они от повтора не пройдут.
AI_RETRIES=2

# Кнопка «Ещё вариант» под сгенерированной картинкой.
AI_REGEN_BUTTON=true
# Разрешить командой /set менять модель и промпт для конкретного чата.
AI_CHAT_SETTINGS=true

# --- AI: зрение, голос, пересказ ---
# Вопросы про присланное фото.
# Пусто -> берётся AI_CHAT_MODEL.
# Если чат-модель картинки НЕ умеет, поставьте off — зрение выключится, чат останется.
AI_VISION_MODEL=

# Модель для видео и аудио. Пусто -> AI_VISION_MODEL, дальше -> AI_CHAT_MODEL.
AI_MEDIA_MODEL=

# Слать видео, аудио, голосовые, кружки, GIF и документы (PDF, txt, ...).
# Картинки и PDF уходят в AI_VISION_MODEL, видео и аудио — в AI_MEDIA_MODEL,
# текстовые файлы вклеиваются прямо в промпт. Вложение берётся и из самого
# сообщения, и из того, на которое отвечают.
# При false голосовые идут через AI_TRANSCRIBE_MODEL, файлы игнорируются.
AI_ATTACHMENTS=true
# Лимит одного вложения
AI_ATTACHMENT_MAX_MB=20

# Как отправлять документы (PDF и прочие бинарники):
#   file   — часть file, как ждёт OpenAI (по умолчанию)
#   inline — сырым data-URI; нужно шлюзам, которые часть file молча теряют
# В режиме inline документ уходит в AI_MEDIA_MODEL вместе с видео и аудио.
AI_DOC_PART=file

# Распознавание речи (/audio/transcriptions), например whisper-1.
# Включает ответы на голосовые и пересказ роликов. Пусто -> обе функции выключены.
AI_TRANSCRIBE_MODEL=
# Лимит на размер аудио для расшифровки, МБ (у шлюзов обычно 25).
AI_TRANSCRIBE_MAX_MB=25

# Озвучка (/audio/speech), например tts-1. Пусто -> /say выключён.
AI_TTS_MODEL=
AI_TTS_VOICE=alloy
# Отвечать на голосовые голосом, а не текстом.
AI_VOICE_REPLY=false

# Как пересказывать ролики (/sum и триггер «Перескажи»).
AI_SUMMARY_PROMPT=Перескажи содержание кратко и по делу, на русском, списком ключевых мыслей. Без вступлений.
AI_SUMMARY_TRIGGERS=Перескажи,Саммари

# --- Самопроверка ---
# Прогон тестов из tests/ при старте и дальше по расписанию. Ловит поломки после
# обновления зависимостей.
SELFCHECK_ENABLED=true
# Раз во сколько часов повторять. 0 -> только при старте.
SELFCHECK_INTERVAL_HOURS=12
# Слать отчёт в TARGET_CHAT_ID: off, fail (только про падения), always.
SELFCHECK_REPORT=fail

# --- Хранилище ---
STATE_FILE=state.db
